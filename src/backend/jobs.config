{
  "jobs": [
    {
      "functionLocation": "/talkEmails.js",
      "functionName": "sendTalkReminders",
      "description": "Email reminders for registered mentor talks",
      "executionConfig": {
        "cronExpression": "0 * * * *"
      }
    },
    {
      "functionLocation": "/discord.js",
      "functionName": "startFocusBlock",
      "description": "Study rooms: focus block announcement at :00 IST",
      "executionConfig": {
        "cronExpression": "30 * * * *"
      }
    },
    {
      "functionLocation": "/discord.js",
      "functionName": "startBreak",
      "description": "Study rooms: break announcement at :50 IST",
      "executionConfig": {
        "cronExpression": "20 * * * *"
      }
    }
  ]
}
