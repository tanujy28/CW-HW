    {
      "functionLocation": "/discord.js",
      "functionName": "startFocusBlock",
      "description": "Study rooms: keep rooms silent and text channels in place (hourly)",
      "executionConfig": {
        "cronExpression": "30 * * * *"
      }
    }
  ]
}
