{
  "jobs": [
    {
      "functionLocation": "/talkEmails.js",
      "functionName": "sendTalkReminders",
      "description": "Email reminders for registered mentor talks",
      "executionConfig": {
        "cronExpression": "0 * * * *"
      }
    },
    {
      "functionLocation": "/discord.js",
      "functionName": "startFocusBlock",
      "description": "Study rooms: keep rooms silent; backup focus message at :00 IST when ownTimer is on",
      "executionConfig": {
        "cronExpression": "30 * * * *"
      }
    },
    {
      "functionLocation": "/discord.js",
      "functionName": "startBreak",
      "description": "Backup timer: break message at :50 IST (only when ownTimer secret is on)",
      "executionConfig": {
        "cronExpression": "20 * * * *"
      }
    }
  ]
}
